{
  "functions": {
    "api/instagram-feed.ts": {
      "maxDuration": 30,
      "includeFiles": "api/_lib/**"
    },
    "api/translate-site-section.ts": {
      "maxDuration": 60,
      "includeFiles": "api/_lib/**,scripts/lib/**"
    },
    "api/translate-catalog-entity.ts": {
      "maxDuration": 60,
      "includeFiles": "api/_lib/**,scripts/lib/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https: https://www.google-analytics.com https://www.googletagmanager.com; media-src 'self' blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://i.instagram.com https://www.instagram.com https://*.tile.openstreetmap.org https://*.basemaps.cartocdn.com https://server.arcgisonline.com https://www.google-analytics.com https://analytics.google.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; frame-src 'self' https://www.googletagmanager.com https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com https://my.matterport.com https://*.matterport.com https://kuula.co https://*.kuula.co https://www.instagram.com; object-src 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "redirects": [
    { "source": "/Locales", "destination": "/renta", "permanent": true },
    { "source": "/locales", "destination": "/renta", "permanent": true },
    { "source": "/Departamentos", "destination": "/renta", "permanent": true },
    { "source": "/departamentos", "destination": "/renta", "permanent": true },
    { "source": "/Casas", "destination": "/venta", "permanent": true },
    { "source": "/casas", "destination": "/venta", "permanent": true },
    { "source": "/s/Nosotros", "destination": "/nosotros", "permanent": true },
    { "source": "/s/nosotros", "destination": "/nosotros", "permanent": true },
    { "source": "/s/Servicios", "destination": "/servicios", "permanent": true },
    { "source": "/nuestros-servicios", "destination": "/servicios", "permanent": true },
    { "source": "/Contacto", "destination": "/contacto", "permanent": true },
    { "source": "/Casas-en-Renta", "destination": "/renta", "permanent": true },
    { "source": "/Casas-en-Renta-Temp", "destination": "/renta", "permanent": true },
    { "source": "/Casas-en-Venta", "destination": "/venta", "permanent": true },
    { "source": "/Casas-Condominio", "destination": "/venta", "permanent": true },
    { "source": "/Departamentos-en-Renta", "destination": "/renta", "permanent": true },
    { "source": "/Departamentos-en-Venta", "destination": "/venta", "permanent": true },
    { "source": "/Bodegas-Industriales", "destination": "/renta", "permanent": true },
    { "source": "/Oficinas", "destination": "/renta", "permanent": true },
    { "source": "/Terrenos", "destination": "/venta", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/p/(\\d+)(.*)",
      "destination": "/api/legacy-listing?kind=p&slug=$1"
    },
    {
      "source": "/d/(\\d+)(.*)",
      "destination": "/api/legacy-listing?kind=d&slug=$1"
    },
    {
      "source": "/p/(.*)",
      "destination": "/api/legacy-listing?kind=p&slug="
    },
    {
      "source": "/d/(.*)",
      "destination": "/api/legacy-listing?kind=d&slug="
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
